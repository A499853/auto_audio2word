{
  "manifest_version": 3,
  "name": "百度直播 · 商品自动讲解助手",
  "version": "1.0.0",
  "description": "在百度直播中控台抓取商品，按自定义序号计划和间隔依次点击讲解商品。支持循环、暂停和状态确认。",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://cecom.baidu.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "百度直播商品自动讲解", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_scripts": [{"matches": ["https://cecom.baidu.com/*"], "js": ["lib/core.js", "lib/adapter.js", "content.js"], "run_at": "document_idle"}],
  "web_accessible_resources": [{"resources": ["panel.css"], "matches": ["https://cecom.baidu.com/*"]}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
